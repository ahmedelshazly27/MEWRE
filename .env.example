# Copy to .env.local and fill in. Everything works without these; the AI tutor and AI grading need a key.
ANTHROPIC_API_KEY=
# Optional: override the tutor model (default claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5
# Optional: where the learner database lives (default ./data/mewre.db)
# MEWRE_DB_PATH=./data/mewre.db
