# Copy to .env.local (local dev) or set in Vercel → Project → Settings → Environment Variables.
# Everything works without these except the AI tutor / AI grading.
ANTHROPIC_API_KEY=
# Optional: comma-separated emails allowed to use the AI tutor (recommended — signups are open).
AI_ALLOWED_EMAILS=
# Optional model overrides. Defaults: Sonnet 5.5 for tutor chat, Haiku 5.5 for rubric grading.
# ANTHROPIC_TUTOR_MODEL=claude-sonnet-5-5
# ANTHROPIC_GRADER_MODEL=claude-haiku-5-5
# Optional: point sync at a different Supabase project (defaults are the publishable values in src/lib/store/supabase.ts)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
